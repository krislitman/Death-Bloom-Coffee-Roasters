# Database (Docker Compose)
POSTGRES_HOST=db
POSTGRES_USER=death_bloom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=death_bloom_development

# Rails
SECRET_KEY_BASE=replace_with_output_of_rails_secret

# Devise
DEVISE_SECRET_KEY=replace_with_output_of_rails_secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Mailgun (production — HTTP API)
# Sending domain is the mg. subdomain: it keeps Mailgun's bounce-handling MX
# records off the root domain, where Proton's MX records live.
MAILGUN_API_KEY=key-replace_me
MAILGUN_DOMAIN=mg.deathbloomcoffeeroasters.com

# App
APP_HOST=localhost:3000
# Customer-facing support address (shown in emails + on terms/privacy, and Reply-To on order emails)
SUPPORT_EMAIL=deathbloomcoffeeroasters@proton.me
# From address on outbound mail. Kept on the root domain: Mailgun signs with
# d=mg.deathbloomcoffeeroasters.com, which satisfies DMARC's default relaxed
# alignment because both share the same organizational domain. Requires that
# this address actually receive mail — customers reply to order confirmations.
MAIL_FROM=hello@deathbloomcoffeeroasters.com

# Admin seeding — production only. `rails db:seed` creates an admin from these
# when RAILS_ENV=production. Unset ADMIN_PASSWORD after the seed run.
# Development seeds a fixed admin@dev.com / admindev123 and ignores these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
