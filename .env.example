# Database (Docker Compose)
POSTGRES_HOST=db
POSTGRES_USER=death_bloom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=death_bloom_development

# Rails
SECRET_KEY_BASE=replace_with_output_of_rails_secret

# Devise
DEVISE_SECRET_KEY=replace_with_output_of_rails_secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Mailgun (production — HTTP API)
MAILGUN_API_KEY=key-replace_me
MAILGUN_DOMAIN=mg.yourdomain.com

# App
APP_HOST=localhost:3000
# Customer-facing support address (shown in emails + on terms/privacy, and Reply-To on order emails)
SUPPORT_EMAIL=deathbloomcoffeeroasters@proton.me
# From address on outbound mail. Set to the Proton address to run everything from one inbox.
# Note: sending From an @proton.me address via Mailgun is not DKIM-aligned — see deploy plan step 2.
MAIL_FROM=deathbloomcoffeeroasters@proton.me
