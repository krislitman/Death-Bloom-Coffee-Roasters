<% content_for :title, "Order #{@order.order_number}" %>

<div class="admin-page zone--dark">
  <div class="container">
    <div class="admin-page__header">
      <%= link_to "← Orders", admin_orders_path, class: "admin-page__back" %>
      <p class="admin-page__eyebrow">Order</p>
      <h1 class="admin-page__heading"><%= @order.order_number %></h1>
    </div>

    <% if notice %>
      <p class="font-mono text-db-accent text-sm tracking-wide mb-8"><%= notice %></p>
    <% end %>

    <div class="grid gap-12 md:grid-cols-[1fr_360px]">
      <div>
        <h2 class="font-mono text-db-muted text-xs tracking-widest uppercase mb-6">Items</h2>
        <table class="orders-table w-full mb-12">
          <thead>
            <tr>
              <th>Coffee</th>
              <th>Qty</th>
              <th>Unit Price</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% @order_items.each do |item| %>
              <tr>
                <td><%= item.coffee.name %></td>
                <td><%= item.quantity %></td>
                <td>$<%= '%.2f' % (item.unit_price_cents / 100.0) %></td>
                <td>$<%= '%.2f' % (item.total_cents / 100.0) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <h2 class="font-mono text-db-muted text-xs tracking-widest uppercase mb-4">Ship To</h2>
        <address class="font-mono text-db-text text-sm not-italic leading-relaxed">
          <%= @order.shipping_address_name %><br>
          <%= @order.shipping_address_line1 %><br>
          <% if @order.shipping_address_line2.present? %><%= @order.shipping_address_line2 %><br><% end %>
          <%= @order.shipping_address_city %>, <%= @order.shipping_address_state %> <%= @order.shipping_address_zip %><br>
          <%= @order.shipping_address_country %>
        </address>
        <p class="font-mono text-db-muted text-xs tracking-wide mt-4"><%= @order.email %></p>
      </div>

      <div>
        <h2 class="font-mono text-db-muted text-xs tracking-widest uppercase mb-6">Fulfillment</h2>
        <%= form_with model: [:admin, @order], method: :patch do |f| %>
          <div class="mb-6">
            <%= f.label :status, class: "block font-mono text-db-muted text-xs tracking-widest uppercase mb-2" %>
            <%= f.select :status, Order.statuses.keys.map { |s| [s.humanize, s] }, {},
                  class: "w-full bg-transparent border border-db-border text-db-text font-mono px-4 py-3 focus:border-db-accent focus:outline-none" %>
          </div>
          <div class="mb-6">
            <%= f.label :carrier, class: "block font-mono text-db-muted text-xs tracking-widest uppercase mb-2" %>
            <%= f.text_field :carrier, placeholder: "USPS / UPS / FedEx",
                  class: "w-full bg-transparent border border-db-border text-db-text font-mono px-4 py-3 focus:border-db-accent focus:outline-none" %>
          </div>
          <div class="mb-8">
            <%= f.label :tracking_number, class: "block font-mono text-db-muted text-xs tracking-widest uppercase mb-2" %>
            <%= f.text_field :tracking_number,
                  class: "w-full bg-transparent border border-db-border text-db-text font-mono px-4 py-3 focus:border-db-accent focus:outline-none" %>
          </div>
          <%= f.submit "Save Fulfillment", class: "btn btn--primary btn--sm" %>
        <% end %>

        <div class="mt-10 pt-8 border-t border-db-border font-mono text-xs tracking-wide text-db-muted space-y-2">
          <p>Placed: <span class="text-db-text"><%= @order.created_at.strftime("%b %-d, %Y %l:%M %p") %></span></p>
          <p>Shipped: <span class="text-db-text"><%= @order.shipped_at&.strftime("%b %-d, %Y") || "—" %></span></p>
          <p>Delivered: <span class="text-db-text"><%= @order.delivered_at&.strftime("%b %-d, %Y") || "—" %></span></p>
          <% if @order.tracking_url %>
            <p><%= link_to "Track shipment ↗", @order.tracking_url, class: "text-db-accent hover:underline", target: "_blank", rel: "noopener" %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
